APP_NAME=LinyTick
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Lokal: "log" hanya menulis email ke storage/logs/laravel.log (tidak terkirim).
# Produksi: gunakan "smtp" dan isi kredensial provider.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Contoh Mailtrap Email Sending (pengiriman nyata, domain harus terverifikasi):
# MAIL_MAILER=smtp
# MAIL_SCHEME=null
# MAIL_HOST=live.smtp.mailtrap.io
# MAIL_PORT=587
# MAIL_USERNAME=api
# MAIL_PASSWORD=API_TOKEN
# MAIL_FROM_ADDRESS=no-reply@domain-anda.com

# Contoh Gmail SMTP (butuh App Password, bukan password akun):
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=akun@gmail.com
# MAIL_PASSWORD=app-password-16-karakter
# MAIL_FROM_ADDRESS=akun@gmail.com

# Undangan staff event (link berlaku 7 hari, kirim ulang dibatasi 60 detik):
# TICKETING_STAFF_INVITATION_TTL_DAYS=7
# TICKETING_STAFF_INVITATION_RESEND_COOLDOWN=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Payment gateway: fake | midtrans | xendit
PAYMENT_GATEWAY=fake
PAYMENT_ORDER_EXPIRY_MINUTES=15

MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_IS_PRODUCTION=false
XENDIT_API_BASE_URL=https://api.xendit.co
XENDIT_SESSION_DURATION_MINUTES=15
XENDIT_REFUND_API_VERSION=2024-11-11
